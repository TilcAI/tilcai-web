# Public URL of the site, used for absolute Open Graph / alternate links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Backend monitor (/[lang]/monitor and /api/monitor) ──
# Shared with the backend (its MONITOR_WEB_SECRET): verifies every delivery of events.
# Empty = the site accepts none.   openssl rand -hex 32
MONITOR_INGEST_SECRET=
# Whoever opens the monitor presents this token. Empty = open in development, closed in production.
MONITOR_DASHBOARD_TOKEN=
# Optional. Keeps the feed across restarts of a single long-lived server (JSON lines).
# Leave empty on serverless hosting: the feed lives in memory there.
MONITOR_STORE_FILE=
# MONITOR_STORE_CAPACITY=2000
